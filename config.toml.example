email_provider = "duckmail" # cloudflare_temp_email | duckmail

[cloudflare_temp_email]
api_url = ""
admin_auth = ""
domain = ""

[duckmail]
api_url = "https://api.duckmail.sbs"
domain = "niceground.shop"  # 勿用 duckmail.sbs（NVIDIA 会拒收）
api_key = ""  # optional: Bearer dk_xxx for private domains

[captcha]
mode = "nonecap" # manual | yescaptcha | captcharun | nonecap
yescaptcha_client_key = ""
yescaptcha_api_url = "https://api.yescaptcha.com"
captcharun_token = ""
captcharun_api_url = "https://api.captcha-run.com"
nonecap_api_key = "nc_live_your_key_here"
poll_interval_seconds = 3
timeout_seconds = 180

[nvidia]
output_csv = "accounts.csv"
key_name = "api"
account_name = "NVIDIA Build"
key_expiry_date = "2126-05-08T08:00:00Z"

[browser]
headless = false
close_delay_seconds = 3
channel = "msedge"  # msedge | chrome | leave empty for bundled Chromium
